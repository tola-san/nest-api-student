# Application
PORT=3000

# PostgreSQL Credentials (used by Docker Compose & Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=student_db
POSTGRES_PORT=5432

# Prisma Database Connection URL
# For local development outside Docker (e.g., npm run start:dev):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_db?schema=public"

# Inside Docker Compose, the host is the Postgres service name 'postgres':
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/student_db?schema=public"
