generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}


model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  image_url String?
  age       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
